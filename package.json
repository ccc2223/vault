{
  "name": "personal-vault",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.cjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test --test-concurrency=1 tests/crypto.test.cjs tests/worker.test.cjs tests/cloud.test.cjs",
    "test:browser": "node --test --test-concurrency=1 tests/vault.test.cjs tests/editor.test.cjs tests/contextmenu.test.cjs tests/sw.test.cjs",
    "provision": "node scripts/provision.mjs",
    "test:runtime": "node --test tests/runtime.test.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "dompurify": "3.4.17",
    "marked": "12.0.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
